    <effect id="M_doctor_Male_generic_Young_asian_male-effect">
      <profile_COMMON>
        <newparam sid="young_lightskinned_male_diffuse3-surface">
          <surface type="2D">
            <init_from>young_lightskinned_male_diffuse3</init_from>
          </surface>
        </newparam>
        <newparam sid="young_lightskinned_male_diffuse3-sampler">
          <sampler2D>
            <source>young_lightskinned_male_diffuse3-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <ambient>
              <color sid="ambient">0 0 0 1</color>
            </ambient>
            <diffuse>
              <texture texture="young_lightskinned_male_diffuse3-sampler" texcoord="UVMap"/>
            </diffuse>
            <specular>
              <color sid="specular">0.027451 0.027451 0.027451 1</color>
            </specular>
            <shininess>
              <float sid="shininess">256</float>
            </shininess>
            <transparent>
              <texture texture="young_lightskinned_male_diffuse3-sampler" texcoord="UVMap"/>
            </transparent>
            <transparency>
              <float sid="transparency">0</float>
            </transparency>
            <index_of_refraction>
              <float sid="index_of_refraction">1</float>
            </index_of_refraction>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
