<?xml version="1.0" ?>
<sdf version="1.6">
  <!-- Minimal test world: flat floor, light, and one static bookshelf only. -->
  <world name="empty_bookshelf">
    <include>
      <!-- z=0 is the floor surface and the bookshelf bottom is placed on it. -->
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://bookshelf</uri>
      <!-- Position (x=2 m, y=0 m), upright at z=0.  yaw=0 leaves the
           bookshelf opening facing -y, away from the robot's default path. -->
      <pose>2 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
