<?xml version="1.0" ?>
<sdf version="1.4">
  <!--
    Local copy of osrf/gazebo_models/bookshelf/model-1_4.sdf.
    The model is static: its collision volumes are an obstacle for Gazebo
    physics while its pose in a world sets the bottom centre on the floor.
    Axes: x = shelf width (0.90 m), y = shelf depth (0.40 m), z = height
    (1.20 m).  The open/front face points toward negative y.
  -->
  <model name="bookshelf">
    <static>true</static>
    <link name="link">
      <inertial>
        <mass>1.0</mass>
      </inertial>
      <collision name="back">
        <pose>0 0.005 0.6 0 0 0</pose>
        <geometry><box><size>0.9 0.01 1.2</size></box></geometry>
      </collision>
      <visual name="back_visual">
        <pose>0 0.005 0.6 0 0 0</pose>
        <geometry><box><size>0.9 0.01 1.2</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
      </visual>

      <collision name="left_side">
        <pose>0.45 -0.195 0.6 0 0 0</pose>
        <geometry><box><size>0.02 0.4 1.2</size></box></geometry>
      </collision>
      <visual name="left_side_visual">
        <pose>0.45 -0.195 0.6 0 0 0</pose>
        <geometry><box><size>0.02 0.4 1.2</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
      </visual>

      <collision name="right_side">
        <pose>-0.45 -0.195 0.6 0 0 0</pose>
        <geometry><box><size>0.02 0.4 1.2</size></box></geometry>
      </collision>
      <visual name="right_side_visual">
        <pose>-0.45 -0.195 0.6 0 0 0</pose>
        <geometry><box><size>0.02 0.4 1.2</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
      </visual>

      <!-- Base, top, and two horizontal dividers form the three shelves. -->
      <collision name="bottom">
        <pose>0 -0.195 0.03 0 0 0</pose>
        <geometry><box><size>0.88 0.4 0.06</size></box></geometry>
      </collision>
      <visual name="bottom_visual">
        <pose>0 -0.195 0.03 0 0 0</pose>
        <geometry><box><size>0.88 0.4 0.06</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
      </visual>

      <collision name="top">
        <pose>0 -0.195 1.19 0 0 0</pose>
        <geometry><box><size>0.88 0.4 0.02</size></box></geometry>
      </collision>
      <visual name="top_visual">
        <pose>0 -0.195 1.19 0 0 0</pose>
        <geometry><box><size>0.88 0.4 0.02</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
      </visual>

      <collision name="low_shelf">
        <pose>0 -0.195 0.43 0 0 0</pose>
        <geometry><box><size>0.88 0.4 0.02</size></box></geometry>
      </collision>
      <visual name="low_shelf_visual">
        <pose>0 -0.195 0.43 0 0 0</pose>
        <geometry><box><size>0.88 0.4 0.02</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
      </visual>

      <collision name="high_shelf">
        <pose>0 -0.195 0.8 0 0 0</pose>
        <geometry><box><size>0.88 0.4 0.02</size></box></geometry>
      </collision>
      <visual name="high_shelf_visual">
        <pose>0 -0.195 0.8 0 0 0</pose>
        <geometry><box><size>0.88 0.4 0.02</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
      </visual>
    </link>
  </model>
</sdf>
