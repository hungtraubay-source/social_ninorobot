<!-- Replan at 2 Hz for dynamic social spaces.  A person can temporarily close a
     corridor, so recovery waits first instead of immediately rotating/backing
     into the person; RoundRobin still reaches the ordinary recoveries later. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- Forty attempts retain the navigation goal while a 12 s crossing actor
         clears the route.  Each failed follow-path cycle returns to the 2 Hz
         planner, so the social costmap is evaluated again after every action. -->
    <RecoveryNode number_of_retries="40" name="SocialNavigateRecovery">
      <PipelineSequence name="NavigateWithFastSocialReplanning">
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputeSocialDetour">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmapContext"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowSocialPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmapContext"
            service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="SocialRecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="SocialRecoveryActions">
          <!-- Dynamic social obstacle: hold position for 2 s, then let the
               pipeline recompute from fresh /people and social-layer data. -->
          <Wait wait_duration="2"/>
          <Sequence name="ClearBothCostmaps">
            <ClearEntireCostmap name="ClearLocalCostmap"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="0.785"/>
          <BackUp backup_dist="0.20" backup_speed="0.08"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
